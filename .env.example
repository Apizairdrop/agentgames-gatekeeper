# Agent Games — environment variables.
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Get the values from the dashboard: https://agentgames.zkverify.io/dashboard

# Port the server listens on. The server binds 0.0.0.0:$PORT by default
# (HOST env overrides the bind address; hosting platforms inject PORT).
PORT=8080

# HMAC secret from the dashboard ("Rotate Secret"). REQUIRED before going live.
# Without it, inbound HMAC verification is disabled (health shows it).
AGENT_GAMES_HMAC_SECRET=

# HMAC encoding: hex (default) or sha256= (if the platform rejects the preflight).
AGENT_GAMES_HMAC_FORMAT=hex

# Gatekeeper taskId mapping: keccak (default), numeric, or hex.
# See gatekeeper/prove.js — confirm against a practice task.
GATEKEEPER_TASK_ID_MODE=keccak

# Kurier API key (free, self-serve at https://kurier.xyz) for on-chain proof
# finalization. Optional — the server always responds with the local proof.
KURIER_API_KEY=
